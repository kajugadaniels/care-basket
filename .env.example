# CareBasket environment variables.
# Copy the names you need into .env.local (or .env) and fill in real values there.
# Never commit real values. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Clerk: adult (family manager) sign-in -------------------------------------
# Keys come from the Clerk Dashboard (API keys page). Use development keys locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key
# Sign-in and sign-up are dialogs. These routes only redirect to the home page and open
# the matching dialog, so Clerk's own redirects never show a separate page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where adults land after signing in or up, unless Clerk carries a valid redirect_url.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/family
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/family

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Not used by the app yet (later steps; see .agents/deployment.md § 3) -------
# DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require
# DIRECT_URL=postgresql://user:password@host/db?sslmode=require
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
# PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
# PAYPAL_CLIENT_SECRET=replace_with_sandbox_client_secret
# PAYPAL_WEBHOOK_ID=replace_with_sandbox_webhook_id
# PAYPAL_ENVIRONMENT=sandbox
# GEMINI_API_KEY=replace_with_your_key
# GEMINI_MODEL=replace_with_model_id
# DEVICE_AUTH_SECRET=replace_with_at_least_32_random_bytes
# DEMO_FULFILLMENT_CONTROLS=true
