# CareBasket production/demo environment.
# Copy this file to a private .env.production only for a controlled deployment.
# Prefer the hosting provider's encrypted environment settings. Never commit secrets.
# Only NEXT_PUBLIC_* values are exposed to the browser and are fixed at build time.

# --- Clerk: demo/production instance ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_production_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_production_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/family
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/family

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://replace-with-demo-domain.example

# --- Managed-device authentication --------------------------------------------
# Generate a production-only value with at least 32 random bytes encoded as base64url.
DEVICE_AUTH_SECRET=replace_with_production_secure_base64url_secret
# Fail closed until the hosting platform and trusted client-IP header are reviewed.
# For a verified direct Vercel deployment, change this to: DEVICE_IP_SOURCE=vercel
DEVICE_IP_SOURCE=unconfigured

# --- Neon PostgreSQL: dedicated demo/production branch ------------------------
# Never reuse the local development database branch.
DATABASE_URL=postgresql://user:password@ep-production-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@ep-production.region.aws.neon.tech/neondb?sslmode=verify-full

# --- PayPal Sandbox: live payments are outside the hackathon scope ------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_with_production_sandbox_client_id
PAYPAL_CLIENT_ID=replace_with_production_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_production_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_with_production_sandbox_webhook_id
PAYPAL_ENVIRONMENT=sandbox

# --- Gemini -------------------------------------------------------------------
GEMINI_API_KEY=replace_with_production_gemini_key
GEMINI_MODEL=replace_with_approved_model_id

# --- Demo and developer-run catalog tooling -----------------------------------
DEMO_FULFILLMENT_CONTROLS=true
CATALOG_USER_AGENT=CareBasket/0.1.0 (replace_with_contact_email)

# --- Optional: add only after the Clerk deletion webhook is approved ----------
CLERK_WEBHOOK_SIGNING_SECRET=replace_with_production_clerk_webhook_secret
