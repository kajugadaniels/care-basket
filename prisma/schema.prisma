// CareBasket database schema. Conventions: .agents/database.md.
// Only the developer runs Prisma CLI commands (see .agents/workflow.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FamilyRole {
  OWNER
  MANAGER
}

enum ProfileKind {
  ASSISTED_ADULT
  CHILD
}

enum PairingStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

/// An adult account holder. Identity, email, and credentials stay in Clerk.
model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  clerkUserId String   @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  membership      FamilyMembership?
  createdProfiles ManagedProfile[]
  approvedPairings DevicePairing[]
  approvedDevices AuthorizedDevice[] @relation("DeviceApprover")
  revokedDevices AuthorizedDevice[] @relation("DeviceRevoker")
	reviewedRequests ShoppingRequest[]
}

/// The deletion root for everything a family owns.
model Family {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships FamilyMembership[]
  profiles    ManagedProfile[]
  auditLogs   AuditLog[]
  pairings    DevicePairing[]
  devices     AuthorizedDevice[]
	requests ShoppingRequest[]
	baskets ShoppingBasket[]
}

/// Links an adult to the family they manage. MVP: one family per adult (unique userId).
model FamilyMembership {
  id          String     @id @default(uuid(7)) @db.Uuid
  familyId    String     @db.Uuid
  userId      String     @unique @db.Uuid
  role        FamilyRole
  displayName String     @db.VarChar(40)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents duplicate memberships even after the one-family rule is relaxed.
  // Its leading familyId column also serves "members of this family" lookups.
  @@unique([familyId, userId])
}

/// A consent-based profile without a Clerk account. AI consent is a separate future flow.
model ManagedProfile {
  id                   String      @id @default(uuid(7)) @db.Uuid
  familyId             String      @db.Uuid
  displayName          String      @db.VarChar(40)
  kind                 ProfileKind
  avatarKey            String      @db.VarChar(30)
  locale               String      @default("en-US") @db.VarChar(10)
  consentConfirmedAt   DateTime    @db.Timestamptz(3)
  consentVersion       String      @db.VarChar(20)
  createdByUserId      String      @db.Uuid
  aiAssistEnabled      Boolean     @default(false)
  aiConsentConfirmedAt DateTime?   @db.Timestamptz(3)
  aiConsentVersion     String?     @db.VarChar(20)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  devices AuthorizedDevice[]
  pairings DevicePairing[]
	requests ShoppingRequest[]

  @@index([familyId, id])
  @@unique([id, familyId])
  @@index([createdByUserId])
}

/// Append-only security events. Opaque IDs only; no profile names or personal text.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  familyId   String?  @db.Uuid
  actorType  String   @db.VarChar(20)
  actorId    String   @db.Uuid
  action     String   @db.VarChar(60)
  targetType String   @db.VarChar(40)
  targetId   String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

/// Only hashes persist. A nullable reservation enforces active-code uniqueness in PostgreSQL.
model DevicePairing {
  id String @id @default(uuid(7)) @db.Uuid
  codeHash String @db.Char(64)
  activeCodeHash String? @unique @db.Char(64)
  secretHash String @unique @db.Char(64)
  status PairingStatus @default(PENDING)
  expiresAt DateTime @db.Timestamptz(3)
  userAgentSummary String @db.VarChar(80)
  label String? @db.VarChar(40)
  familyId String? @db.Uuid
  profileId String? @db.Uuid
  approvedByUserId String? @db.Uuid
  approvedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile ManagedProfile? @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)
  approvedBy User? @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([codeHash, status])
  @@index([expiresAt])
  @@index([familyId, profileId])
  @@index([profileId, familyId])
  @@index([approvedByUserId])
}

model AuthorizedDevice {
  id String @id @default(uuid(7)) @db.Uuid
  familyId String @db.Uuid
  profileId String @db.Uuid
  label String @db.VarChar(40)
  tokenHash String @unique @db.Char(64)
  userAgentSummary String @db.VarChar(80)
  approvedByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  revokedByUserId String? @db.Uuid

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  profile ManagedProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)
  approvedBy User @relation("DeviceApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  revokedBy User? @relation("DeviceRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
	requests ShoppingRequest[]

  @@index([familyId, id])
  @@index([familyId, profileId, revokedAt, expiresAt])
  @@index([profileId, familyId])
  @@index([approvedByUserId])
  @@index([revokedByUserId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model RateLimitCounter {
  key String @db.VarChar(128)
  windowStart DateTime @db.Timestamptz(3)
  count Int
  expiresAt DateTime @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
}

enum ProductCategory {
	PRODUCE
	DAIRY_EGGS
	BAKERY
	PANTRY
	BREAKFAST
	MEAT_SEAFOOD
	FROZEN
	SNACKS
	BEVERAGES
	HOUSEHOLD
	PERSONAL_CARE
}

enum QuantityUnit {
	GRAM
	MILLILITER
	COUNT
}

enum CatalogSource {
	OPEN_PRICES
	CAREBASKET_CURATED
}

enum PriceBasis {
	OBSERVED_MEDIAN
	OBSERVED_LIMITED
	MANUAL_DEMO
}

/// Shared, curated data; not owned by a family. Archive products rather than deleting them.
model CatalogProduct {
	id String @id @default(uuid(7)) @db.Uuid
	sku String @unique @db.VarChar(60)
	barcode String? @unique @db.VarChar(14)
	displayName String @db.VarChar(60)
	brand String? @db.VarChar(60)
	category ProductCategory
	variantGroup String @db.VarChar(60)
	netQuantity Int
	netQuantityUnit QuantityUnit
	sizeLabel String @db.VarChar(40)
	synonyms String[]
	imagePath String? @db.VarChar(200)
	imageSourceUrl String? @db.VarChar(300)
	imageProductUrl String? @db.VarChar(300)
	imageLicense String? @db.VarChar(40)
	imageAttribution String? @db.VarChar(120)
	source CatalogSource
	sourceProductId Int? @unique
	sourceProductCode String? @db.VarChar(14)
	sourceSystem String? @db.VarChar(10)
	sourceLicense String @db.VarChar(40)
	isActive Boolean @default(true)
	isChildSuitable Boolean @default(false)
	archivedAt DateTime? @db.Timestamptz(3)
	createdAt DateTime @default(now()) @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @db.Timestamptz(3)

	demoPrices DemoMerchantPrice[]
	basketItems BasketItem[]

	@@index([isActive, archivedAt, id])
	@@index([category, isActive, archivedAt, id])
	@@index([isChildSuitable, isActive, archivedAt, id])
	@@index([variantGroup])
	@@index([synonyms], type: Gin)
}

/// Historical source observations never become authoritative without explicit human approval.
model DemoMerchantPrice {
	id String @id @default(uuid(7)) @db.Uuid
	productId String @db.Uuid
	currency String @db.Char(3)
	priceMinor Int
	basis PriceBasis
	observationCount Int?
	observedFrom DateTime? @db.Date
	observedTo DateTime? @db.Date
	approvedAt DateTime @db.Timestamptz(3)
	createdAt DateTime @default(now()) @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @db.Timestamptz(3)

	product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

	@@unique([productId, currency])
}

enum InputMode {
	PICTURES
	TEXT
	VOICE
}

enum RequestStatus {
	PENDING_REVIEW
	AWAITING_PAYMENT
	PAID
	DECLINED
	CANCELLED
}

enum FulfillmentStatus {
	NOT_STARTED
	PREPARING
	DELIVERED
}

enum ItemOrigin {
	REQUESTED
	SUGGESTED
}

model ShoppingRequest {
	id String @id @default(uuid(7)) @db.Uuid
	familyId String @db.Uuid
	profileId String @db.Uuid
	deviceId String? @db.Uuid
	clientRequestKey String @db.Uuid
	// Immutable original contents, independent of subsequent basket edits.
	submissionHash String @db.Char(64)
	// Every mutation compares and increments this revision atomically.
	revision Int @default(0)
	inputMode InputMode
	inputText String? @db.VarChar(1000)
	budgetMinor Int?
	status RequestStatus @default(PENDING_REVIEW)
	fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
	reviewedByUserId String? @db.Uuid
	reviewedAt DateTime? @db.Timestamptz(3)
	submittedAt DateTime @default(now()) @db.Timestamptz(3)
	createdAt DateTime @default(now()) @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @db.Timestamptz(3)

	family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
	profile ManagedProfile @relation(fields: [profileId, familyId], references: [id, familyId], onDelete: Cascade)
	device AuthorizedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
	reviewedBy User? @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
	basket ShoppingBasket?

	@@unique([profileId, clientRequestKey])
	@@index([familyId, status, id])
	@@index([profileId, familyId, id])
	@@index([deviceId])
	@@index([reviewedByUserId])
	@@unique([id, familyId])
}

model ShoppingBasket {
	id String @id @default(uuid(7)) @db.Uuid
	requestId String @unique @db.Uuid
	familyId String @db.Uuid
	currency String @default("USD") @db.Char(3)
	subtotalMinor Int
	lockedAt DateTime? @db.Timestamptz(3)
	createdAt DateTime @default(now()) @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @db.Timestamptz(3)

	request ShoppingRequest @relation(fields: [requestId, familyId], references: [id, familyId], onDelete: Cascade)
	family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
	items BasketItem[]

	@@unique([requestId, familyId])
	@@index([familyId])
}

model BasketItem {
	id String @id @default(uuid(7)) @db.Uuid
	basketId String @db.Uuid
	productId String @db.Uuid
	quantity Int
	unitPriceMinor Int
	origin ItemOrigin @default(REQUESTED)
	isSubstitute Boolean @default(false)
	substitutionNote String? @db.VarChar(120)
	createdAt DateTime @default(now()) @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @db.Timestamptz(3)

	basket ShoppingBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
	product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

	@@unique([basketId, productId])
	@@index([productId])
}
