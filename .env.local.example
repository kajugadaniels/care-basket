# CareBasket local-development environment.
# Copy this file to .env.local and replace every required placeholder there.
# Never commit .env.local or paste its values into issues, logs, or documentation.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Clerk: development instance ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_local_key
CLERK_SECRET_KEY=sk_test_replace_with_local_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/family
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/family

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Managed-device authentication --------------------------------------------
# Generate a unique value with at least 32 random bytes encoded as base64url.
# Do not reuse this value in production or reuse another provider's key.
DEVICE_AUTH_SECRET=replace_with_local_secure_base64url_secret
# Local development intentionally uses one shared database-limited start bucket.
DEVICE_IP_SOURCE=unconfigured

# --- Neon PostgreSQL: development branch --------------------------------------
# Runtime uses the pooled URL; Prisma migrations use the direct URL.
DATABASE_URL=postgresql://user:password@ep-local-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@ep-local.region.aws.neon.tech/neondb?sslmode=verify-full

# --- PayPal Sandbox: required when the payment step is implemented ------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace_with_local_sandbox_client_id
PAYPAL_CLIENT_ID=replace_with_local_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_local_sandbox_client_secret
PAYPAL_WEBHOOK_ID=replace_with_local_sandbox_webhook_id
PAYPAL_ENVIRONMENT=sandbox

# --- Gemini: required when the AI step is implemented -------------------------
GEMINI_API_KEY=replace_with_local_gemini_key
GEMINI_MODEL=replace_with_approved_model_id
# Remains blocked until deployment eligibility is documented in source and policy.
GEMINI_SHOPPING_ENABLED=false

# --- Demo and developer-run catalog tooling -----------------------------------
DEMO_FULFILLMENT_CONTROLS=true
CATALOG_USER_AGENT=CareBasket/0.1.0 (replace_with_contact_email)

# --- Optional: add only after the Clerk deletion webhook is approved ----------
CLERK_WEBHOOK_SIGNING_SECRET=replace_with_local_clerk_webhook_secret
